<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ai_chat_sheet"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ai_chat_header"
        android:orientation="vertical">

        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ai_chat_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_ai_chat_avatar"
                android:gravity="center"
                android:text="AI"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trợ lý nội thất"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ai_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hỏi nhanh về sản phẩm, phòng và giá"
                    android:textColor="#F0E4D8"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_clear_ai_chat"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Xóa lịch sử"
                android:src="@drawable/ic_delete"
                app:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_ai_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/layout_ai_welcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:text="AI"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_ai_chat_bot"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:text="Xin chào! Mình là trợ lý mua sắm nội thất 🛋️\n\nMình có thể giúp bạn tìm sản phẩm, gợi ý đồ nội thất theo phòng và thêm vào giỏ hàng. Thử chạm gợi ý bên dưới hoặc đặt câu hỏi nhé!"
                android:textColor="#2D2D2D"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_ai_guest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ai_chat_sheet"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_ai_chat_avatar"
                android:gravity="center"
                android:text="AI"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Đăng nhập để dùng trợ lý AI"
                android:textColor="#424242"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Bạn cần đăng nhập để trò chuyện với trợ lý mua sắm"
                android:textColor="#757575"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ai_login"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:text="Đăng nhập"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:backgroundTint="@color/primary" />
        </LinearLayout>
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/quick_chip_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/chip_sofa"
                style="@style/AiQuickChip"
                android:text="Tìm sofa phòng khách" />

            <TextView
                android:id="@+id/chip_under_5m"
                style="@style/AiQuickChip"
                android:text="Sản phẩm dưới 5 triệu" />

            <TextView
                android:id="@+id/chip_bedroom"
                style="@style/AiQuickChip"
                android:text="Gợi ý phòng ngủ" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layout_ai_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/et_ai_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input"
            android:hint="Nhập tin nhắn..."
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="#2D2D2D"
            android:textColorHint="#9B918B"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btn_ai_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_send_button"
            android:contentDescription="Gửi"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@android:color/white" />
    </LinearLayout>
</LinearLayout>

# ============================================================
# Android Local Configuration Template
# Copy this file to local.properties. Do not commit local.properties.
# ============================================================

# Android SDK path. Android Studio usually fills this automatically.
sdk.dir=C\:\\Users\\YOUR_USERNAME\\AppData\\Local\\Android\\Sdk

# Backend base URL.
#
# Android emulator:
#   base.url=http://10.0.2.2:8080/api/
#
# Real device on the same WiFi as the backend machine:
#   base.url=http://192.168.x.x:8080/api/
#
# Deployed backend:
#   base.url=https://your-domain.com/api/
base.url=http://192.168.20.19:8080/api/

# Google Sign-In Web Client ID (OAuth 2.0 Client ID type: Web application).
#
# Debug builds use the shared key at android-app/shared-debug.keystore.
# Add this SHA-1 to the Google Cloud Android OAuth client:


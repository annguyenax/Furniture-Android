# ============================================================
# Furniture Shop — Environment Variables Template
# Sao chép file này thành .env (không commit .env lên git)
# ============================================================

# Database
DB_USERNAME=root
DB_PASSWORD=root

# JWT Secret — tối thiểu 64 ký tự, dùng ký tự ngẫu nhiên
# Tạo: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-64-char-string-eg-openssl-rand-base64-48

# Cloudinary — lấy từ https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
APP_FRONTEND_URL=http://localhost:3000
APP_EMAIL_SEND_ENABLED=false

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
